PROJECT_NAME           = "Laying Grass"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = doc

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

INPUT                  = README.md \
                         docs/mainpage.md \
                         include \
                         src \
                         main.cpp
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp \
                         *.cc \
                         *.cxx \
                         *.md
RECURSIVE              = YES
EXCLUDE                = nlohmann \
                         raylib \
                         cmake-build-debug \
                         cmake-build-release
EXCLUDE_PATTERNS       = */nlohmann/* \
                         */raylib/* \
                         */cmake-build-debug/* \
                         */cmake-build-release/*

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
INPUT_ENCODING         = UTF-8
STRIP_FROM_PATH        = ${CMAKE_SOURCE_DIR}

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

JAVADOC_AUTOBRIEF      = NO
MULTILINE_CPP_IS_BRIEF = YES

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
